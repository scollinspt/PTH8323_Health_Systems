---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout
  title="PTH8323 Health Systems"
  description="PTH8323 course companion for project development and scenario-based review in healthcare systems."
  active="home"
>
  <section class="hero" aria-labelledby="page-title">
    <div class="hero-copy">
      <p class="eyebrow">Plymouth State University · Fall 2026</p>
      <h1 class="question-title" id="page-title">What problem is the system <em>actually trying to solve?</em></h1>
      <p class="hero-intro">Examine how healthcare is organized, what needs it is meant to resolve, and how policy, payment, leadership, organizations, and communities shape physical therapy practice, access, and outcomes.</p>
    </div>

    <figure class="system-figure" aria-labelledby="system-caption">
      <div class="system-grid" aria-hidden="true">
        <svg class="system-connectors" viewBox="0 0 300 300" preserveAspectRatio="none">
          <line x1="150" y1="150" x2="150" y2="50" />
          <line x1="150" y1="150" x2="50" y2="150" />
          <line x1="150" y1="150" x2="250" y2="150" />
          <line x1="150" y1="150" x2="50" y2="250" />
          <line x1="150" y1="150" x2="250" y2="250" />
        </svg>
        <span class="system-node policy">Policy</span>
        <span class="system-node payment">Payment</span>
        <span class="system-node center">People<br />& communities</span>
        <span class="system-node organizations">Organizations</span>
        <span class="system-node workforce">Workforce</span>
        <span class="system-node outcomes">Outcomes</span>
      </div>
      <figcaption id="system-caption"><strong>Health systems are connected.</strong> A change in one part creates consequences elsewhere.</figcaption>
    </figure>
  </section>

  <section class="site-purpose" aria-labelledby="purpose-title">
    <div class="section-shell">
      <div class="purpose-heading">
        <p class="section-label">Two purposes</p>
        <h2 id="purpose-title">Choose where you want to work.</h2>
      </div>
      <div class="purpose-options">
        <article>
          <p class="option-number">01</p>
          <div>
            <p class="option-status">First release in development</p>
            <h3>Project Studio</h3>
            <p>Explore possible project directions, diagnose a system, and reason through approaches and their consequences.</p>
            <a class="option-link" href={`${base}project/`}>Explore the project framework <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <article>
          <p class="option-number">02</p>
          <div>
            <p class="option-status">Planned</p>
            <h3>Scenario Review</h3>
            <p>Work through difficult cases involving healthcare systems, payment, policy, leadership, advocacy, and management.</p>
            <a class="option-link" href={`${base}review/`}>See the review approach <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <aside class="authority-note section-shell" aria-label="Course information boundary">
    <strong>Course companion</strong>
    <p>This site supports project development and scenario review. The syllabus, Canvas, and in-class instructions remain the authoritative sources for course requirements, deadlines, submissions, and grading.</p>
  </aside>
</BaseLayout>