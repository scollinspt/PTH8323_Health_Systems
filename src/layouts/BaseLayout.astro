---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active?: 'home' | 'project' | 'review';
}

const { title, description, active } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173e43" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <a class="course-brand" href={base} aria-label="PTH8323 Health Systems home">
        <span class="brand-code">PTH<br />8323</span>
        <span><strong>Health Systems</strong><small>Doctor of Physical Therapy</small></span>
      </a>
      <nav class="primary-nav" aria-label="Primary navigation">
        <a href={base} aria-current={active === 'home' ? 'page' : undefined}>Home</a>
        <a href={`${base}project/`} aria-current={active === 'project' ? 'page' : undefined}>Project Studio</a>
        <a href={`${base}review/`} aria-current={active === 'review' ? 'page' : undefined}>Scenario Review</a>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <div class="footer-mark">
        <span>PTH8323</span>
        <strong>Health Systems</strong>
        <p>Plymouth State University · Doctor of Physical Therapy</p>
      </div>
      <div class="footer-resources">
        <p class="footer-heading">Instructor & related work</p>
        <nav class="footer-links" aria-label="Instructor and related work">
          <a href="https://scollinspt.github.io/">Sean Collins</a>
          <a href="https://scollinspt.github.io/projects.html">Projects</a>
          <a href="https://stats4pt.org/">stats4PT</a>
          <a href="https://physiolog.org/">Physiolog</a>
          <a href="https://github.com/scollinspt">GitHub</a>
        </nav>
      </div>
      <p class="footer-privacy">This public site does not collect student responses, grades, or identifying information.</p>
    </footer>
  </body>
</html>